<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.growthlens.mapper.ChatRecordMapper">

    <resultMap id="BaseResultMap" type="com.example.growthlens.entity.ChatRecord">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="session_id" property="sessionId"/>
        <result column="scene_type" property="sceneType"/>
        <result column="scene_sub_type" property="sceneSubType"/>
        <result column="user_question" property="userQuestion"/>
        <result column="ai_answer" property="aiAnswer"/>
        <result column="is_collected" property="isCollected"/>
        <result column="ai_call_id" property="aiCallId"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM chat_record WHERE id = #{id}
    </select>

    <select id="findByUserId" resultMap="BaseResultMap">
        SELECT * FROM chat_record WHERE user_id = #{userId} ORDER BY create_time DESC
    </select>

    <select id="findByUserIdAndSceneType" resultMap="BaseResultMap">
        SELECT * FROM chat_record WHERE user_id = #{userId} AND scene_type = #{sceneType} ORDER BY create_time DESC
    </select>

    <select id="findCollectedByUserId" resultMap="BaseResultMap">
        SELECT * FROM chat_record WHERE user_id = #{userId} AND is_collected = 1 ORDER BY create_time DESC
    </select>

    <select id="findBySessionId" resultMap="BaseResultMap">
        SELECT * FROM chat_record WHERE session_id = #{sessionId} ORDER BY create_time ASC
    </select>

    <insert id="insert" parameterType="com.example.growthlens.entity.ChatRecord" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO chat_record (
            user_id, session_id, scene_type, scene_sub_type, user_question, ai_answer,
            is_collected, ai_call_id, create_time
        ) VALUES (
            #{userId}, #{sessionId}, #{sceneType}, #{sceneSubType}, #{userQuestion}, #{aiAnswer},
            #{isCollected}, #{aiCallId}, NOW()
        )
    </insert>

    <update id="updateCollection">
        UPDATE chat_record SET is_collected = #{isCollected} WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM chat_record WHERE id = #{id}
    </delete>

    <delete id="deleteBySessionId">
        DELETE FROM chat_record WHERE session_id = #{sessionId}
    </delete>

</mapper>
